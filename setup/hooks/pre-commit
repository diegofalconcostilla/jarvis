#!/usr/bin/env bash
# Blocks commits that contain secrets or private files. Bypass only with care: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0
if echo "$files" | grep -qE '(^|/)\.env$|consent\.json$|\.pem$|id_(rsa|ed25519)$'; then
  echo "Blocked: a private file is staged (.env / consent / key). Unstage it."; exit 1
fi
# shellcheck disable=SC2086
python3 -m jarvis scan $files || { echo "Blocked: possible secret in staged files (see above)."; exit 1; }
