<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Job applications: once a day at 05:00. New postings from the configured public job boards, local fit
     scores, Gmail status tracking; Mondays: resumes + cover letters for the week and a weekly summary. Yields to the incubator. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.jarvis.jobs</string>
    <key>ProgramArguments</key>
    <array><string>/usr/bin/python3</string><string>-m</string><string>jarvis.jobs</string></array>
    <key>WorkingDirectory</key><string>__REPO__</string>
    <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>__HOME__/Library/Logs/jarvis-jobs.log</string>
    <key>StandardErrorPath</key><string>__HOME__/Library/Logs/jarvis-jobs.log</string>
</dict>
</plist>
